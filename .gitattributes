# CD line-ending policy: LF for authored text; explicit exceptions below.
* text=auto eol=lf

# Windows-native text exceptions.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary containers and media.
*.zip binary
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Binary containers and media.
*.webp binary
*.mp4 binary

# Preserve current sealed customer bytes.
/release-v0.2.1/** -text
/release-assets/v0.2.1/** -text
/delivery-v0.2.1/** -text
